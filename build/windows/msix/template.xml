<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="worklogger"
        Arguments=""
        InstallLocation="C:\Program Files\Roland Molnár\WorkLogger">
    </Installer>
    <PackageInformation
        PackageName="WorkLogger"
        PackageDisplayName="WorkLogger"
        PublisherName="CN=Roland Molnár"
        PublisherDisplayName="Roland Molnár"
        Version="0.2.0.0"
        PackageDescription="Month-end worklogs from git, calendars and chats">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="hu.molnarroland.worklogger"
                Description="Month-end worklogs from git, calendars and chats"
                DisplayName="WorkLogger"
                ExecutableName="worklogger"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>WorkLogger</DisplayName>
            <PublisherDisplayName>Roland Molnár</PublisherDisplayName>
            <Description>Month-end worklogs from git, calendars and chats</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="worklogger.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
